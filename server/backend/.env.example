# BiliBrief 后端环境变量模板。deploy.ps1 / deploy.sh 首次部署时复制为 .env（已存在则不覆盖）。
# 注意：API_BASE_URL 只填 scheme+host，不要带端口 —— 端口由 BACKEND_PORT 拼在后面
# （见 app/services/note.py 的 BACKEND_BASE_URL），写成带端口的会拼出双端口 URL。

# 通用
ENV=production
API_BASE_URL=http://127.0.0.1
SCREENSHOT_BASE_URL=http://127.0.0.1
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL
DATA_DIR=data

# 服务监听。改端口后要同步改技能 config.json 里的 backend_url
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8483

# ffmpeg 目录（填目录，不是 exe 路径）。留空则从系统 PATH 查找；
# 刚用 winget 装完但 PATH 未刷新时，把 bin 目录填在这里最稳。
# 例：C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_...\bin
FFMPEG_BIN_PATH=

# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou
WHISPER_MODEL_SIZE=base
